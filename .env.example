# Autonomous SRE Agent - Environment Variables Template
# Copy this file to .env and replace the placeholder values with your real configuration.

# Discord Webhook URL for remote Human-In-The-Loop (HITL) approval notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Public base URL of the SRE Webhook Listener (e.g. ngrok / localhost.run tunnel or domain)
# Used to construct clickable /approve/{thread_id} and /reject/{thread_id} action links
BASE_URL=http://localhost:5000
